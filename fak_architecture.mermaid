graph TB
    subgraph "Agent Layer"
        LLM[Large Language Model]
        Planner[Agent Planner/Reasoner]
        LLM -->|generates reasoning| Planner
    end

    subgraph "Formal Agent Kernel (FAK)"
        subgraph "Agent Definition Store"
            AgentSpec["Agent Specification
            ⟨M, G, A, C⟩"]
            MotivationOnt[Motivation Ontology]
            ConstraintLib[Constraint Library<br/>Z Specifications]
        end

        subgraph "Runtime Validation Engine"
            ActionInt[Action Interceptor]
            Parser[Action Parser]
            ConstraintCheck{Constraint Checker<br/>⟨M,G,A⟩ ⊨ C?}
            StateTracker[State Tracker<br/>Agent History]
            ExplainGen[Explanation Generator]
        end

        subgraph "Verification Components"
            PrePost[Pre/Post-condition<br/>Verifier]
            TemporalMon[Temporal Logic<br/>Monitor LTL/CTL]
            InvariantCheck[Invariant Checker]
            ResourceBound[Resource Bound<br/>Validator]
        end
    end

    subgraph "Execution Layer"
        Executor[Action Executor]
        ExtAPI[External APIs]
        Resources[Resources<br/>Files/DB/Network]
        AuditLog[Audit Log]
    end

    %% Flow
    Planner -->|proposes action| ActionInt
    ActionInt -->|parses| Parser
    Parser -->|structured action| ConstraintCheck
    
    AgentSpec -->|loads constraints| ConstraintCheck
    StateTracker -->|current state| ConstraintCheck
    
    ConstraintCheck -->|delegates to| PrePost
    ConstraintCheck -->|delegates to| TemporalMon
    ConstraintCheck -->|delegates to| InvariantCheck
    ConstraintCheck -->|delegates to| ResourceBound
    
    ConstraintCheck -->|✓ valid| Executor
    ConstraintCheck -->|✗ violation| ExplainGen
    
    Executor -->|executes| ExtAPI
    Executor -->|executes| Resources
    Executor -->|logs| AuditLog
    StateTracker -->|updates| AuditLog
    
    ExplainGen -->|denial reason| Planner
    Executor -->|result| Planner

    %% Styling
    classDef kernel fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    classDef agent fill:#fff4e6,stroke:#ff9800,stroke-width:2px
    classDef exec fill:#f1f8e9,stroke:#558b2f,stroke-width:2px
    classDef verify fill:#fce4ec,stroke:#c2185b,stroke-width:2px
    
    class ActionInt,Parser,ConstraintCheck,StateTracker,ExplainGen,AgentSpec,MotivationOnt,ConstraintLib kernel
    class LLM,Planner agent
    class Executor,ExtAPI,Resources,AuditLog exec
    class PrePost,TemporalMon,InvariantCheck,ResourceBound verify
